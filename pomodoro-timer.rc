#include <windows.h>
#pragma code_page(65001)

120 DIALOGEX 0, 0, 220, 156
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "颜色"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "字体:", -1, 10, 13, 22, 10
    COMBOBOX 5101, 34, 10, 84, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "大小:", -1, 124, 13, 22, 10
    COMBOBOX 5102, 148, 10, 62, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "颜色:", -1, 10, 31, 22, 10
    EDITTEXT 5100, 34, 28, 115, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "选色", 5110, 155, 28, 55, 14
    CONTROL "", 5120, "EDIT", ES_MULTILINE | ES_READONLY | ES_CENTER | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP, 10, 48, 200, 62
    LTEXT "", 5131, 10, 116, 200, 12
    PUSHBUTTON "全屏预览", 5132, 10, 132, 60, 14
    DEFPUSHBUTTON "确定", IDOK, 95, 132, 50, 14
    PUSHBUTTON "取消", IDCANCEL, 160, 132, 50, 14
END

121 DIALOGEX 0, 0, 220, 218
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "签名"
FONT 8, "MS Shell Dlg"
BEGIN
    EDITTEXT 5200, 10, 10, 200, 48, ES_MULTILINE | ES_WANTRETURN | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT "字体:", -1, 10, 67, 22, 10
    COMBOBOX 5207, 34, 64, 84, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "大小:", -1, 124, 67, 22, 10
    COMBOBOX 5208, 148, 64, 62, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "颜色:", -1, 10, 85, 22, 10
    EDITTEXT 5205, 34, 82, 115, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "选色", 5206, 155, 82, 55, 14
    CONTROL "", 5202, "EDIT", ES_MULTILINE | ES_READONLY | ES_CENTER | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP, 10, 102, 200, 62
    LTEXT "", 5204, 10, 170, 200, 12
    PUSHBUTTON "全屏预览", 5203, 10, 186, 60, 14
    DEFPUSHBUTTON "确定", IDOK, 95, 186, 50, 14
    PUSHBUTTON "取消", IDCANCEL, 160, 186, 50, 14
END

// Dialog IDs
#define IDD_SETTINGS 100
#define IDD_ABOUT 101
#define IDC_POMODORO 101
#define IDC_SHORT_BREAK 102
#define IDC_LONG_BREAK 103
#define IDC_OK 104
#define IDC_CANCEL 105
#define IDC_CLOCK_SOUND 106
#define IDC_AUTOSTART 107
#define IDC_WEBSITE 108
#define IDC_COFFEE 109
#define IDD_INPUT 110
#define IDC_INPUT_LABEL 110
#define IDC_INPUT_EDIT 111
#define IDC_LABEL_POMODORO 201
#define IDC_LABEL_SHORT_BREAK 202
#define IDC_LABEL_LONG_BREAK 203
#define IDC_LABEL_CUSTOM 204
#define IDC_CUSTOM_TIMER 205
#define IDC_SHORT_POMODORO 220
#define IDC_LABEL_SHORT_POMODORO 221
#define IDC_DEFAULT_LONG_POMODORO 222
#define IDC_DEFAULT_SHORT_POMODORO 223
#define IDC_DEFAULT_SHORT_BREAK 224
#define IDC_DEFAULT_LONG_BREAK 225
#define IDC_ABOUT_TITLE 210
#define IDC_ABOUT_SUBTITLE 211
#define IDC_ABOUT_AUTHOR 212

// Sound resources
CLOCK_WAV WAV "clock.wav"
DING_WAV WAV "ding.wav"

// Settings Dialog
IDD_SETTINGS DIALOGEX 0, 0, 220, 242
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "番茄钟设置"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "长番茄钟时长(分钟):", IDC_LABEL_POMODORO, 10, 10, 140, 10
    EDITTEXT        IDC_POMODORO, 150, 10, 50, 14, ES_NUMBER
    LTEXT           "短番茄钟时长(分钟):", IDC_LABEL_SHORT_POMODORO, 10, 30, 130, 10
    EDITTEXT        IDC_SHORT_POMODORO, 150, 30, 50, 14, ES_NUMBER
    LTEXT           "短休息时长(分钟):", IDC_LABEL_SHORT_BREAK, 10, 50, 130, 10
    EDITTEXT        IDC_SHORT_BREAK, 150, 50, 50, 14, ES_NUMBER
    LTEXT           "长休息时长(分钟):", IDC_LABEL_LONG_BREAK, 10, 70, 130, 10
    EDITTEXT        IDC_LONG_BREAK, 150, 70, 50, 14, ES_NUMBER
    LTEXT           "自定义计时时长(分钟):", IDC_LABEL_CUSTOM, 10, 90, 130, 10
    EDITTEXT        IDC_CUSTOM_TIMER, 150, 90, 50, 14, ES_NUMBER
    GROUPBOX        "默认番茄钟", -1, 10, 112, 200, 32
    AUTORADIOBUTTON "长番茄钟", IDC_DEFAULT_LONG_POMODORO, 20, 126, 75, 10, WS_GROUP
    AUTORADIOBUTTON "短番茄钟", IDC_DEFAULT_SHORT_POMODORO, 110, 126, 75, 10
    GROUPBOX        "默认休息", -1, 10, 148, 200, 32
    AUTORADIOBUTTON "短休息", IDC_DEFAULT_SHORT_BREAK, 20, 162, 75, 10, WS_GROUP
    AUTORADIOBUTTON "长休息", IDC_DEFAULT_LONG_BREAK, 110, 162, 75, 10
    AUTOCHECKBOX    "启用时钟音效", IDC_CLOCK_SOUND, 10, 188, 120, 10
    AUTOCHECKBOX    "开机启动", IDC_AUTOSTART, 10, 204, 120, 10
    DEFPUSHBUTTON   "确定", IDC_OK, 60, 224, 50, 14
    PUSHBUTTON      "取消", IDCANCEL, 120, 224, 50, 14
END

// About Dialog
IDD_ABOUT DIALOGEX 0, 0, 180, 130
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "关于番茄钟"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "番茄钟计时器 v2.5.14", IDC_ABOUT_TITLE, 10, 10, 160, 10
    LTEXT           "一个简洁的效率工具", IDC_ABOUT_SUBTITLE, 10, 25, 160, 10
    LTEXT           "作者: Ferenc Lutischan", IDC_ABOUT_AUTHOR, 10, 40, 160, 10
    LTEXT           "访问项目主页", IDC_WEBSITE, 10, 55, 160, 10, SS_NOTIFY
    LTEXT           "支持作者（请喝咖啡）", IDC_COFFEE, 10, 75, 160, 10, SS_NOTIFY
    DEFPUSHBUTTON   "确定", IDOK, 65, 105, 50, 14
END

IDI_ICON1 ICON "pomodoro-timer.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,5,14,0
 PRODUCTVERSION 2,5,14,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "Pomodoro Timer Contributors\0"
            VALUE "FileDescription", "番茄钟计时器\0"
            VALUE "FileVersion", "2.5.14\0"
            VALUE "InternalName", "pomodoro-timer\0"
            VALUE "OriginalFilename", "pomodoro-timer.exe\0"
            VALUE "ProductName", "番茄钟计时器\0"
            VALUE "ProductVersion", "2.5.14\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END

// Generic integer input dialog
IDD_INPUT DIALOGEX 0, 0, 180, 74
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "输入数值"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "请输入数字:", IDC_INPUT_LABEL, 10, 10, 150, 10
    EDITTEXT        IDC_INPUT_EDIT, 10, 25, 160, 14, ES_AUTOHSCROLL | ES_NUMBER
    DEFPUSHBUTTON   "确定", IDOK, 40, 50, 45, 14
    PUSHBUTTON      "取消", IDCANCEL, 95, 50, 45, 14
END
